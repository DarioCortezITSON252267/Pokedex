<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Pokedex.Text" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Pokedex.Text.Name">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Pokedex.Text.Number">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Pokedex.Text.Type">
        <item name="android:background">@drawable/bg_type_chip</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Pokedex.Text.StatLabel">
        <item name="android:textColor">@color/pokedex_red</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Pokedex.Text.StatValue">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Pokedex.Text.Description">
        <item name="android:layout_width">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Pokedex.Text.NavLabel">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Pokedex.NavArrow" parent="">
        <item name="android:layout_width">@dimen/nav_arrow_size</item>
        <item name="android:layout_height">@dimen/nav_arrow_size</item>
    </style>

    <style name="Pokedex.NavImage" parent="">
        <item name="android:layout_width">@dimen/nav_image_size</item>
        <item name="android:layout_height">@dimen/nav_image_size</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
